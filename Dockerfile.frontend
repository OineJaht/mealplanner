# Build stage
FROM node:18-alpine AS build
WORKDIR /app

# Copy package files
COPY meal-planner-client/package*.json ./

# Install dependencies with verbose logging
RUN npm ci --verbose

# Copy source code
COPY meal-planner-client/ ./

ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Build the Vue app - modify the build script to be more resilient
RUN npm run build:safe || npm run build || npx vite build

# Production stage
FROM nginx:alpine AS runtime

# Copy built app from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Create a simple nginx config for Vue.js SPA with LOCAL backend proxy
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    # Proxy API calls to the local backend service \
    location /api/ { \
        proxy_pass http://host.docker.internal:5001/api/; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto $scheme; \
        proxy_set_header X-Forwarded-Host $host; \
        proxy_set_header X-Forwarded-Port $server_port; \
    } \
}' > /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]