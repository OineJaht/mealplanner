@model MealPlanner.BLL.DTO.MealPlanDetail
@{
ViewData["Title"] = MealLocalizer["DeleteMealPlan"];

// Count meals in the plan
var mealCount = Model.MealPlanItems?.Count ?? 0;
bool isActive = Model.StartDate <= DateTime.UtcNow && Model.EndDate >= DateTime.UtcNow;
}

<h1>@MealLocalizer["DeleteMealPlan"]</h1>

<div class="alert alert-danger">
    <h4>@MealLocalizer["DeleteConfirmation"]</h4>
    <p>@MealLocalizer["DeleteWarning"]</p>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center @(isActive ? "bg-warning text-dark" : "")">
        <h5 class="mb-0">@MealLocalizer["PlanDetails"]</h5>
        @if (isActive)
        {
        <span class="badge bg-danger">@MealLocalizer["ActivePlan"]</span>
        }
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@MealLocalizer["PlanName"]</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">@MealLocalizer["StartDate"]</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("dddd, MMMM d, yyyy")</dd>

            <dt class="col-sm-3">@MealLocalizer["EndDate"]</dt>
            <dd class="col-sm-9">@Model.EndDate.ToString("dddd, MMMM d, yyyy")</dd>

            <dt class="col-sm-3">@MealLocalizer["Duration"]</dt>
            <dd class="col-sm-9">@((Model.EndDate - Model.StartDate).Days + 1) @MealLocalizer["Days"]</dd>

            <dt class="col-sm-3">@MealLocalizer["TotalMealsPlanned"]</dt>
            <dd class="col-sm-9">@mealCount @MealLocalizer["MealsCount"]</dd>
        </dl>
    </div>
</div>

@if (mealCount > 0)
{
<div class="alert alert-warning">
    <h5>@MealLocalizer["Warning"]</h5>
    <p>@string.Format(MealLocalizer["PlanContainsMeals"], mealCount)</p>

    @if (isActive)
    {
    <p class="text-danger"><strong>@MealLocalizer["ActivePlanWarning"]</strong></p>
    }
</div>

<div class="card mb-4">
    <div class="card-header">
        <h5>@MealLocalizer["PlannedMeals"]</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                <tr>
                    <th>@MealLocalizer["Date"]</th>
                    <th>@MealLocalizer["MealType"]</th>
                    <th>@MealLocalizer["Recipe"]</th>
                    <th>@MealLocalizer["Servings"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.MealPlanItems?.OrderBy(i => i.PlannedDate).Take(10) ?? Enumerable.Empty<MealPlanner.BLL.DTO.MealPlanItem>())
                {
                <tr>
                    <td>@item.PlannedDate.ToShortDateString()</td>
                    <td>@item.MealType</td>
                    <td>@(item.RecipeName ?? MealLocalizer["RecipeNotFound"])</td>
                    <td>@item.Servings</td>
                </tr>
                }

                @if (mealCount > 10)
                {
                <tr>
                    <td colspan="4" class="text-center">
                        <em>And @(mealCount - 10) more meals...</em>
                    </td>
                </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
}

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="d-flex justify-content-between mt-4">
        <a asp-action="Index" class="btn btn-secondary">@Localizer["Cancel"]</a>
        <button type="submit" class="btn btn-danger">@MealLocalizer["DeleteMealPlan"]</button>
    </div>
</form>