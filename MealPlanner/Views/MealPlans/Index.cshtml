@model IEnumerable<MealPlanner.BLL.DTO.MealPlan>

@{
    ViewData["Title"] = MealLocalizer["MealPlans"];
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@MealLocalizer["MealPlans"]</h1>
        <div>
            <button id="createPlanBtn" class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#createPlanModal">
                <i class="bi bi-plus-circle"></i> @MealLocalizer["CreateNew"]
            </button>
            <a asp-action="Create" class="btn btn-outline-primary">
                <i class="bi bi-plus-circle"></i> @MealLocalizer["CreateNew"] (@Localizer["StandardForm"])
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>@MealLocalizer["PlanName"]</th>
                                <th>@MealLocalizer["StartDate"]</th>
                                <th>@MealLocalizer["EndDate"]</th>
                                <th class="text-center">@MealLocalizer["Duration"]</th>
                                <th>@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id">@item.Name</a>
                                    </td>
                                    <td>@item.StartDate.ToShortDateString()</td>
                                    <td>@item.EndDate.ToShortDateString()</td>
                                    <td class="text-center">
                                        @{
                                            var days = (item.EndDate - item.StartDate).Days + 1;
                                            <span>@days @(days == 1 ? MealLocalizer["Day"] : MealLocalizer["Days"])</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-eye"></i> @Localizer["Details"]
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil"></i> @Localizer["Edit"]
                                            </a>
                                            <a asp-action="AddItem" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-plus-circle"></i> @MealLocalizer["AddMeal"]
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> @Localizer["Delete"]
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i> @MealLocalizer["NoMealPlansFound"]
                </div>
                <div class="text-center mt-4">
                    <p>@MealLocalizer["CreateYourFirstPlan"]</p>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createPlanModal">
                        <i class="bi bi-plus-circle"></i> @MealLocalizer["CreateFirstPlan"]
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create Plan Modal -->
<div class="modal fade" id="createPlanModal" tabindex="-1" aria-labelledby="createPlanModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createPlanModalLabel">@MealLocalizer["CreateNewPlan"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createPlanForm">
                    @Html.AntiForgeryToken()
                    <div id="validation-summary" class="text-danger"></div>
                    
                    <div class="mb-3">
                        <label for="Name" class="form-label">@MealLocalizer["PlanName"]</label>
                        <input type="text" class="form-control" id="Name" name="Name" required>
                        <div class="invalid-feedback" data-valmsg-for="Name"></div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="StartDate" class="form-label">@MealLocalizer["StartDate"]</label>
                        <input type="date" class="form-control" id="StartDate" name="StartDate" required>
                        <div class="invalid-feedback" data-valmsg-for="StartDate"></div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="EndDate" class="form-label">@MealLocalizer["EndDate"]</label>
                        <input type="date" class="form-control" id="EndDate" name="EndDate" required>
                        <div class="invalid-feedback" data-valmsg-for="EndDate"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="button" id="createPlanSubmit" class="btn btn-primary">@Localizer["Create"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function() {
            // Set default dates
            const today = new Date();
            const endDate = new Date();
            endDate.setDate(today.getDate() + 6); // Default to 7-day plan
            
            $('#StartDate').val(today.toISOString().split('T')[0]);
            $('#EndDate').val(endDate.toISOString().split('T')[0]);
            
            // Form validation and submission
            $('#createPlanSubmit').click(function() {
                // Clear previous validation errors
                $('#validation-summary').html('');
                $('.is-invalid').removeClass('is-invalid');
                
                // Validate form
                let isValid = true;
                const name = $('#Name').val();
                const startDate = $('#StartDate').val();
                const endDate = $('#EndDate').val();
                
                if (!name) {
                    $('#Name').addClass('is-invalid');
                    $('[data-valmsg-for="Name"]').text('@MealLocalizer["NameRequired"]');
                    isValid = false;
                }
                
                if (!startDate) {
                    $('#StartDate').addClass('is-invalid');
                    $('[data-valmsg-for="StartDate"]').text('@MealLocalizer["StartDateRequired"]');
                    isValid = false;
                }
                
                if (!endDate) {
                    $('#EndDate').addClass('is-invalid');
                    $('[data-valmsg-for="EndDate"]').text('@MealLocalizer["EndDateRequired"]');
                    isValid = false;
                }
                
                if (new Date(endDate) < new Date(startDate)) {
                    $('#EndDate').addClass('is-invalid');
                    $('[data-valmsg-for="EndDate"]').text('@MealLocalizer["EndDateMustBeAfterStartDate"]');
                    isValid = false;
                }
                
                if (!isValid) return;
                
                // Prepare form data
                const formData = {
                    Name: name,
                    StartDate: startDate,
                    EndDate: endDate,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                };
                
                // Submit form via Ajax
                $.ajax({
                    url: '@Url.Action("CreateAjax")',
                    type: 'POST',
                    data: formData,
                    success: function(result) {
                        if (result.success) {
                            window.location.href = result.redirectUrl;
                        } else {
                            $('#validation-summary').html(
                                `<div class="alert alert-danger">${result.message}</div>`
                            );
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#validation-summary').html(
                            `<div class="alert alert-danger">An error occurred: ${error}</div>`
                        );
                    }
                });
            });
            
            // Date validation
            $('#EndDate').change(function() {
                const startDate = new Date($('#StartDate').val());
                const endDate = new Date($(this).val());
                
                if (endDate < startDate) {
                    $(this).addClass('is-invalid');
                    $('[data-valmsg-for="EndDate"]').text('@MealLocalizer["EndDateMustBeAfterStartDate"]');
                } else {
                    $(this).removeClass('is-invalid');
                    $('[data-valmsg-for="EndDate"]').text('');
                }
            });
            
            $('#StartDate').change(function() {
                if ($('#EndDate').val()) {
                    const startDate = new Date($(this).val());
                    const endDate = new Date($('#EndDate').val());
                    
                    if (endDate < startDate) {
                        $('#EndDate').addClass('is-invalid');
                        $('[data-valmsg-for="EndDate"]').text('@MealLocalizer["EndDateMustBeAfterStartDate"]');
                    } else {
                        $('#EndDate').removeClass('is-invalid');
                        $('[data-valmsg-for="EndDate"]').text('');
                    }
                }
            });
        });
    </script>
}