@model MealPlanner.Dto.ShoppingListCreateDto
@{
    <h2>@ShoppingLocalizer["CreateShoppingList"]</h2>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ShoppingLocalizer["CreateShoppingList"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> @ShoppingLocalizer["BackToList"]
    </a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4>@ShoppingLocalizer["NewShoppingList"]</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label">@ShoppingLocalizer["ListName"]</label>
                        <input asp-for="Name" class="form-control" placeholder="Weekly Groceries, Party Shopping, etc." />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">@Localizer["Cancel"]</a>
                        <div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> @ShoppingLocalizer["CreateNew"]
                            </button>
                            <a asp-action="CreateFromMealPlan" class="btn btn-success">
                                <i class="bi bi-calendar-plus"></i> @ShoppingLocalizer["CreateFromMealPlanInstead"]
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4>@ShoppingLocalizer["ShoppingListTips"]</h4>
            </div>
            <div class="card-body">
                <h5>@ShoppingLocalizer["WaysToUseShoppingLists"]</h5>
                <ul>
                    <li>@ShoppingLocalizer["WeeklyGroceryTip"]</li>
                    <li>@ShoppingLocalizer["SpecialOccasionTip"]</li>
                    <li>@ShoppingLocalizer["AutomaticGenerationTip"]</li>
                    <li>@ShoppingLocalizer["SpecializedListsTip"]</li>
                    <li>@ShoppingLocalizer["ShareListsTip"]</li>
                </ul>

                <div class="alert alert-info mt-3">
                    <h5><i class="bi bi-lightbulb"></i> @ShoppingLocalizer["ProTip"]</h5>
                    <p>
                        @ShoppingLocalizer["ProTipContent"]
                    </p>
                </div>

                <div class="alert alert-success mt-3">
                    <h5>@ShoppingLocalizer["CreateFromMealPlanTitle"]</h5>
                    <p>
                        @ShoppingLocalizer["CreateFromMealPlanContent"]
                        <a asp-action="CreateFromMealPlan" class="alert-link">@Localizer["ClickHere"]</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}