@model MealPlanner.Models.ViewModels.Nutrition.IngredientNutritionViewModel
@{
    ViewData["Title"] = NutritionLocalizer["IngredientNutrition"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@NutritionLocalizer["IngredientNutrition"] - @Model.IngredientName</h1>
    <a asp-controller="Ingredients" asp-action="Details" asp-route-id="@Model.IngredientId" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> @NutritionLocalizer["BackToIngredient"]
    </a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h4>@NutritionLocalizer["EditNutritionInformation"]</h4>
                <small class="text-muted">@NutritionLocalizer["ValuesPerPortion"]</small>
            </div>
            <div class="card-body">
                @if (Model.Nutrition.Id == 0)
                {
                <form asp-action="CreateIngredientNutrition" asp-route-id="@Model.IngredientId">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Nutrition.Id"/>
                    <input type="hidden" asp-for="Nutrition.IngredientId"/>

                    <div class="form-group mb-3">
                        <label asp-for="Nutrition.CaloriesPer100g" class="form-label">@NutritionLocalizer["CaloriesPer100g"]</label>
                        <div class="input-group">
                            <input asp-for="Nutrition.CaloriesPer100g" class="form-control"/>
                            <span class="input-group-text">kcal</span>
                        </div>
                        <span asp-validation-for="Nutrition.CaloriesPer100g" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Nutrition.ProteinG" class="form-label">@NutritionLocalizer["Protein"]</label>
                                <div class="input-group">
                                    <input asp-for="Nutrition.ProteinG" class="form-control"/>
                                    <span class="input-group-text">g</span>
                                </div>
                                <span asp-validation-for="Nutrition.ProteinG" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Nutrition.CarbsG" class="form-label">@NutritionLocalizer["Carbohydrates"]</label>
                                <div class="input-group">
                                    <input asp-for="Nutrition.CarbsG" class="form-control"/>
                                    <span class="input-group-text">g</span>
                                </div>
                                <span asp-validation-for="Nutrition.CarbsG" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Nutrition.FatG" class="form-label">@NutritionLocalizer["Fat"]</label>
                                <div class="input-group">
                                    <input asp-for="Nutrition.FatG" class="form-control"/>
                                    <span class="input-group-text">g</span>
                                </div>
                                <span asp-validation-for="Nutrition.FatG" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Nutrition.FiberG" class="form-label">@NutritionLocalizer["Fiber"]</label>
                                <div class="input-group">
                                    <input asp-for="Nutrition.FiberG" class="form-control"/>
                                    <span class="input-group-text">g</span>
                                </div>
                                <span asp-validation-for="Nutrition.FiberG" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Nutrition.SugarG" class="form-label">@NutritionLocalizer["Sugar"]</label>
                                <div class="input-group">
                                    <input asp-for="Nutrition.SugarG" class="form-control"/>
                                    <span class="input-group-text">g</span>
                                </div>
                                <span asp-validation-for="Nutrition.SugarG" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Nutrition.SodiumMg" class="form-label">@NutritionLocalizer["Sodium"]</label>
                                <div class="input-group">
                                    <input asp-for="Nutrition.SodiumMg" class="form-control"/>
                                    <span class="input-group-text">mg</span>
                                </div>
                                <span asp-validation-for="Nutrition.SodiumMg" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary">@NutritionLocalizer["SaveChanges"]</button>
                    </div>
                </form>
                }
                else
                {
                <form asp-action="UpdateIngredientNutrition" asp-route-id="@Model.Nutrition.Id">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Nutrition.Id"/>
                    <input type="hidden" asp-for="Nutrition.IngredientId"/>

                    <div class="form-group mb-3">
                        <label asp-for="Nutrition.CaloriesPer100g" class="form-label">@NutritionLocalizer["CaloriesPer100g"]</label>
                        <div class="input-group">
                            <input asp-for="Nutrition.CaloriesPer100g" class="form-control"/>
                            <span class="input-group-text">kcal</span>
                        </div>
                        <span asp-validation-for="Nutrition.CaloriesPer100g" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Nutrition.ProteinG" class="form-label">@NutritionLocalizer["Protein"]</label>
                                <div class="input-group">
                                    <input asp-for="Nutrition.ProteinG" class="form-control"/>
                                    <span class="input-group-text">g</span>
                                </div>
                                <span asp-validation-for="Nutrition.ProteinG" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Nutrition.CarbsG" class="form-label">@NutritionLocalizer["Carbohydrates"]</label>
                                <div class="input-group">
                                    <input asp-for="Nutrition.CarbsG" class="form-control"/>
                                    <span class="input-group-text">g</span>
                                </div>
                                <span asp-validation-for="Nutrition.CarbsG" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Nutrition.FatG" class="form-label">@NutritionLocalizer["Fat"]</label>
                                <div class="input-group">
                                    <input asp-for="Nutrition.FatG" class="form-control"/>
                                    <span class="input-group-text">g</span>
                                </div>
                                <span asp-validation-for="Nutrition.FatG" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Nutrition.FiberG" class="form-label">@NutritionLocalizer["Fiber"]</label>
                                <div class="input-group">
                                    <input asp-for="Nutrition.FiberG" class="form-control"/>
                                    <span class="input-group-text">g</span>
                                </div>
                                <span asp-validation-for="Nutrition.FiberG" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Nutrition.SugarG" class="form-label">@NutritionLocalizer["Sugar"]</label>
                                <div class="input-group">
                                    <input asp-for="Nutrition.SugarG" class="form-control"/>
                                    <span class="input-group-text">g</span>
                                </div>
                                <span asp-validation-for="Nutrition.SugarG" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Nutrition.SodiumMg" class="form-label">@NutritionLocalizer["Sodium"]</label>
                                <div class="input-group">
                                    <input asp-for="Nutrition.SodiumMg" class="form-control"/>
                                    <span class="input-group-text">mg</span>
                                </div>
                                <span asp-validation-for="Nutrition.SodiumMg" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary">@NutritionLocalizer["SaveChanges"]</button>
                    </div>
                </form>
                }
            </div>
        </div>

        <!-- Rest of the card content remains the same -->
        <div class="card">
            <div class="card-header">
                <h4>@NutritionLocalizer["DataSources"]</h4>
            </div>
            <div class="card-body">
                <p>@NutritionLocalizer["NutritionDataSources"]</p>
                <ul>
                    <li>USDA FoodData Central: <a href="https://fdc.nal.usda.gov/" target="_blank">https://fdc.nal.usda.gov/</a></li>
                    <li>@NutritionLocalizer["PackagingLabels"]</li>
                    <li>@NutritionLocalizer["ManufacturerWebsites"]</li>
                    <li>@NutritionLocalizer["NutritionDatabases"]</li>
                </ul>
                <p class="text-muted">
                    @NutritionLocalizer["NutritionVariation"]
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h4>@NutritionLocalizer["NutritionFacts"]</h4>
                <small class="text-muted">@NutritionLocalizer["PerServing"]</small>
            </div>
            <div class="card-body">
                <div class="nutrition-facts">
                    <div class="nutrition-facts-header">
                        <h2 class="nutrition-facts-title">@NutritionLocalizer["NutritionFacts"]</h2>
                        <p>@NutritionLocalizer["ServingSize"]</p>
                        <p class="nutrition-facts-calories">@NutritionLocalizer["Calories"]: @Model.Nutrition.CaloriesPer100g</p>
                    </div>

                    <table class="table nutrition-table">
                        <tr>
                            <th colspan="3" class="nutrition-facts-header-element">@NutritionLocalizer["AmountPerServing"]</th>
                        </tr>
                        <tr>
                            <th>@NutritionLocalizer["TotalFat"]</th>
                            <td>@Model.Nutrition.FatG g</td>
                            <td>@(Model.Nutrition.CaloriesPer100g == 0 ? "0" : Math.Round((Model.Nutrition.FatG * 9 / Model.Nutrition.CaloriesPer100g) * 100, 1).ToString())%</td>
                        </tr>
                        <tr>
                            <th>@NutritionLocalizer["TotalCarbohydrates"]</th>
                            <td>@Model.Nutrition.CarbsG g</td>
                            <td>@(Model.Nutrition.CaloriesPer100g == 0 ? "0" : Math.Round((Model.Nutrition.CarbsG * 4 / Model.Nutrition.CaloriesPer100g) * 100, 1).ToString())%</td>
                        </tr>
                        <tr>
                            <th class="ps-4">@NutritionLocalizer["DietaryFiber"]</th>
                            <td>@Model.Nutrition.FiberG g</td>
                            <td></td>
                        </tr>
                        <tr>
                            <th class="ps-4">@NutritionLocalizer["Sugars"]</th>
                            <td>@Model.Nutrition.SugarG g</td>
                            <td></td>
                        </tr>
                        <tr>
                            <th>@NutritionLocalizer["Protein"]</th>
                            <td>@Model.Nutrition.ProteinG g</td>
                            <td>@(Model.Nutrition.CaloriesPer100g == 0 ? "0" : Math.Round((Model.Nutrition.ProteinG * 4 / Model.Nutrition.CaloriesPer100g) * 100, 1).ToString())%</td>
                        </tr>
                        <tr>
                            <th>@NutritionLocalizer["Sodium"]</th>
                            <td>@Model.Nutrition.SodiumMg mg</td>
                            <td></td>
                        </tr>
                    </table>
                    <div class="mt-3">
                        <div class="progress mb-3" style="height: 25px;">
                            @{
                            decimal proteinPercentage = Model.Nutrition.CaloriesPer100g == 0 ? 0 : Math.Round((Model.Nutrition.ProteinG * 4 / Model.Nutrition.CaloriesPer100g) * 100, 0);
                            decimal carbPercentage = Model.Nutrition.CaloriesPer100g == 0 ? 0 : Math.Round((Model.Nutrition.CarbsG * 4 / Model.Nutrition.CaloriesPer100g) * 100, 0);
                            decimal fatPercentage = Model.Nutrition.CaloriesPer100g == 0 ? 0 : Math.Round((Model.Nutrition.FatG * 9 / Model.Nutrition.CaloriesPer100g) * 100, 0);
                            }
                            <div class="progress-bar bg-success" role="progressbar" style="width: @proteinPercentage%">
                                @NutritionLocalizer["Protein"]
                            </div>
                            <div class="progress-bar bg-warning" role="progressbar" style="width: @carbPercentage%">
                                @NutritionLocalizer["Carbs"]
                            </div>
                            <div class="progress-bar bg-danger" role="progressbar" style="width: @fatPercentage%">
                                @NutritionLocalizer["Fat"]
                            </div>
                        </div>
                        <div class="d-flex justify-content-between">
                            <small>@NutritionLocalizer["Protein"]: @proteinPercentage%</small>
                            <small>@NutritionLocalizer["Carbs"]: @carbPercentage%</small>
                            <small>@NutritionLocalizer["Fat"]: @fatPercentage%</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- The rest of the card content remains the same -->
        <div class="card">
            <div class="card-header">
                <h4>@NutritionLocalizer["WhyThisMatters"]</h4>
            </div>
            <div class="card-body">
                <p>@NutritionLocalizer["NutritionMattersDescription"]</p>
                <ul>
                    <li>@NutritionLocalizer["CalculateNutrition"]</li>
                    <li>@NutritionLocalizer["TrackDailyNutrientIntake"]</li>
                    <li>@NutritionLocalizer["MakeInformedChoices"]</li>
                    <li>@NutritionLocalizer["CompareIngredients"]</li>
                </ul>
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    @NutritionLocalizer["AutoCalculateDescription"]
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
    .nutrition-facts {
        border: 1px solid #333;
        padding: 0.5rem;
        font-family: 'Helvetica', 'Arial', sans-serif;
    }

    .nutrition-facts-header {
        border-bottom: 8px solid #333;
        padding-bottom: 0.25rem;
        margin-bottom: 0.5rem;
    }

    .nutrition-facts-title {
        font-weight: bold;
        font-size: 2rem;
        margin-bottom: 0.25rem;
    }

    .nutrition-facts-calories {
        font-size: 1.25rem;
        font-weight: bold;
    }

    .nutrition-facts-header-element {
        border-bottom: 4px solid #333;
        font-weight: bold;
    }

    .nutrition-table {
        width: 100%;
        border-bottom: 8px solid #333;
    }
</style>
}

@section Scripts {
@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
