@model MealPlanner.Models.ViewModels.Nutrition.NutritionSummaryViewModel
@{
    ViewData["Title"] = NutritionLocalizer["NutritionSummary"];

    // Function to calculate total nutrition for a meal plan
    (decimal calories, decimal protein, decimal carbs, decimal fat) CalculateTotals(MealPlanner.Dto.MealPlanDetailDto plan)
    {
        decimal totalCalories = 0;
        decimal totalProtein = 0;
        decimal totalCarbs = 0;
        decimal totalFat = 0;

        if (plan.MealPlanItems != null)
        {
            foreach (var item in plan.MealPlanItems)
            {
                // Find the recipe
                var recipe = item.RecipeName != null ? item : null;
                
                // If we have recipe nutrition data
                if (recipe != null && item.Recipe?.Nutrition != null)
                {
                    // Calculate based on servings
                    if (item.Recipe.DefaultServings > 0)
                    {
                        var servingMultiplier = (decimal)item.Servings / item.Recipe.DefaultServings;
                        totalCalories += item.Recipe.Nutrition.TotalCalories * servingMultiplier;
                        totalProtein += item.Recipe.Nutrition.TotalProteinG * servingMultiplier;
                        totalCarbs += item.Recipe.Nutrition.TotalCarbsG * servingMultiplier;
                        totalFat += item.Recipe.Nutrition.TotalFatG * servingMultiplier;
                    }
                }
            }
        }

        return (totalCalories, totalProtein, totalCarbs, totalFat);
    }

    // Function to calculate daily averages for a meal plan
    (decimal calories, decimal protein, decimal carbs, decimal fat) CalculateDailyAverages(MealPlanner.Dto.MealPlanDetailDto plan)
    {
        var totals = CalculateTotals(plan);
        int days = (plan.EndDate - plan.StartDate).Days + 1;

        if (days <= 0) days = 1; // Prevent division by zero

        return (
            Math.Round(totals.calories / days, 1),
            Math.Round(totals.protein / days, 1),
            Math.Round(totals.carbs / days, 1),
            Math.Round(totals.fat / days, 1)
        );
    }
}

<h1>@NutritionLocalizer["NutritionSummary"]</h1>

<div class="row mt-4">
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header">
                <h4>@NutritionLocalizer["DailyTargetRanges"]</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-light">
                        <tr>
                            <th>@NutritionLocalizer["Nutrient"]</th>
                            <th>@NutritionLocalizer["TargetRangeAdult"]</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr>
                            <td>@NutritionLocalizer["Calories"]</td>
                            <td>1,800 - 2,500 kcal</td>
                        </tr>
                        <tr>
                            <td>@NutritionLocalizer["Protein"]</td>
                            <td>50 - 175g (10-35%)</td>
                        </tr>
                        <tr>
                            <td>@NutritionLocalizer["Carbohydrates"]</td>
                            <td>225 - 325g (45-65%)</td>
                        </tr>
                        <tr>
                            <td>@NutritionLocalizer["Fat"]</td>
                            <td>44 - 78g (20-35%)</td>
                        </tr>
                        <tr>
                            <td>@NutritionLocalizer["Fiber"]</td>
                            <td>25 - 30g</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
                <div class="alert alert-info small">
                    <i class="bi bi-info-circle"></i>
                    @NutritionLocalizer["GeneralGuidelines"]
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h4>@NutritionLocalizer["MealPlanNutritionTips"]</h4>
            </div>
            <div class="card-body">
                <ul>
                    <li>@NutritionLocalizer["TipBalancedMacros"]</li>
                    <li>@NutritionLocalizer["TipVariety"]</li>
                    <li>@NutritionLocalizer["TipTiming"]</li>
                    <li>@NutritionLocalizer["TipNutritionInfo"]</li>
                    <li>@NutritionLocalizer["TipCalculate"]</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header">
                <h4>@NutritionLocalizer["RecentMealPlansAnalysis"]</h4>
            </div>
            <div class="card-body">
                @if (Model.MealPlans != null && Model.MealPlans.Any())
                {
                <div class="accordion" id="mealPlanNutritionAccordion">
                    @foreach (var plan in Model.MealPlans)
                    {
                    var planId = $"plan_{plan.Id}";
                    var dailyAvg = CalculateDailyAverages(plan);
                    var isActive = plan.StartDate <= DateTime.UtcNow && plan.EndDate >= DateTime.UtcNow;

                    <div class="accordion-item @(isActive ? "border-success" : "")">
                        <h2 class="accordion-header" id="heading_@planId">
                            <button class="accordion-button @(isActive ? "" : "collapsed") @(isActive ? "bg-success text-white" : "")"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse_@planId"
                                    aria-expanded="@(isActive ? "true" : "false")"
                                    aria-controls="collapse_@planId">

                                @plan.Name (@plan.StartDate.ToShortDateString() - @plan.EndDate.ToShortDateString())

                                @if (isActive)
                                {
                                <span class="badge bg-light text-success ms-2">@NutritionLocalizer["Active"]</span>
                                }
                            </button>
                        </h2>
                        <div id="collapse_@planId"
                             class="accordion-collapse collapse @(isActive ? "show" : "")"
                             aria-labelledby="heading_@planId"
                             data-bs-parent="#mealPlanNutritionAccordion">
                            <div class="accordion-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h5>@NutritionLocalizer["DailyAverageNutrition"]</h5>
                                        <div class="table-responsive">
                                            <table class="table table-sm">
                                                <tr>
                                                    <th>@NutritionLocalizer["Calories"]:</th>
                                                    <td>@dailyAvg.calories kcal</td>
                                                </tr>
                                                <tr>
                                                    <th>@NutritionLocalizer["Protein"]:</th>
                                                    <td>@dailyAvg.protein g</td>
                                                </tr>
                                                <tr>
                                                    <th>@NutritionLocalizer["Carbohydrates"]:</th>
                                                    <td>@dailyAvg.carbs g</td>
                                                </tr>
                                                <tr>
                                                    <th>@NutritionLocalizer["Fat"]:</th>
                                                    <td>@dailyAvg.fat g</td>
                                                </tr>
                                                <tr>
                                                    <th>@NutritionLocalizer["Duration"]:</th>
                                                    <td>@((plan.EndDate - plan.StartDate).Days + 1) @NutritionLocalizer["Days"]</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <h5>@NutritionLocalizer["MacronutrientDistribution"]</h5>
                                        <div class="progress mb-3" style="height: 25px;">
                                            @{
                                            var proteinPercentage = dailyAvg.calories > 0 ? Math.Round((dailyAvg.protein * 4 / dailyAvg.calories) * 100, 0) : 0;
                                            var carbPercentage = dailyAvg.calories > 0 ? Math.Round((dailyAvg.carbs * 4 / dailyAvg.calories) * 100, 0) : 0;
                                            var fatPercentage = dailyAvg.calories > 0 ? Math.Round((dailyAvg.fat * 9 / dailyAvg.calories) * 100, 0) : 0;
                                            }
                                            <div class="progress-bar bg-success" role="progressbar"
                                                 style="width: @proteinPercentage%">
                                                @NutritionLocalizer["Protein"]
                                            </div>
                                            <div class="progress-bar bg-warning" role="progressbar"
                                                 style="width: @carbPercentage%">
                                                @NutritionLocalizer["Carbs"]
                                            </div>
                                            <div class="progress-bar bg-danger" role="progressbar"
                                                 style="width: @fatPercentage%">
                                                @NutritionLocalizer["Fat"]
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <small>@NutritionLocalizer["Protein"]: @proteinPercentage%</small>
                                            <small>@NutritionLocalizer["Carbs"]: @carbPercentage%</small>
                                            <small>@NutritionLocalizer["Fat"]: @fatPercentage%</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <a asp-controller="MealPlans" asp-action="Details" asp-route-id="@plan.Id" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye"></i> @NutritionLocalizer["ViewPlanDetails"]
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    }
                </div>
                }
                else
                {
                <div class="alert alert-info">
                    <p>@NutritionLocalizer["NoMealPlansFound"]</p>
                    <a asp-controller="MealPlans" asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> @NutritionLocalizer["CreateMealPlan"]
                    </a>
                </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h4>@NutritionLocalizer["NutritionTrends"]</h4>
            </div>
            <div class="card-body">
                @if (Model.MealPlans != null && Model.MealPlans.Count() >= 2)
                {
                <div class="chart-container" style="height: 300px;">
                    <canvas id="nutritionTrendsChart"></canvas>
                </div>
                }
                else
                {
                <div class="alert alert-info">
                    <p>@NutritionLocalizer["NeedMoreMealPlans"]</p>
                </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    @if (Model.MealPlans != null && Model.MealPlans.Count() >= 2)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const ctx = document.getElementById('nutritionTrendsChart').getContext('2d');
                
                // Prepare data for the chart
                const plans = @Html.Raw(Json.Serialize(Model.MealPlans.Select(p => p.Name).ToArray()));
                const calories = @Html.Raw(Json.Serialize(Model.MealPlans.Select(p => (double)CalculateDailyAverages(p).calories).ToArray()));
                const protein = @Html.Raw(Json.Serialize(Model.MealPlans.Select(p => (double)CalculateDailyAverages(p).protein).ToArray()));
                const carbs = @Html.Raw(Json.Serialize(Model.MealPlans.Select(p => (double)CalculateDailyAverages(p).carbs).ToArray()));
                const fat = @Html.Raw(Json.Serialize(Model.MealPlans.Select(p => (double)CalculateDailyAverages(p).fat).ToArray()));

                const nutritionChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: plans,
                        datasets: [
                            {
                                label: 'Daily Calories (kcal)',
                                data: calories,
                                backgroundColor: 'rgba(54, 162, 235, 0.5)',
                                borderColor: 'rgba(54, 162, 235, 1)',
                                borderWidth: 1,
                                yAxisID: 'y'
                            },
                            {
                                label: 'Protein (g)',
                                data: protein,
                                backgroundColor: 'rgba(75, 192, 192, 0.5)',
                                borderColor: 'rgba(75, 192, 192, 1)',
                                borderWidth: 1,
                                yAxisID: 'y1'
                            },
                            {
                                label: 'Carbs (g)',
                                data: carbs,
                                backgroundColor: 'rgba(255, 206, 86, 0.5)',
                                borderColor: 'rgba(255, 206, 86, 1)',
                                borderWidth: 1,
                                yAxisID: 'y1'
                            },
                            {
                                label: 'Fat (g)',
                                data: fat,
                                backgroundColor: 'rgba(255, 99, 132, 0.5)',
                                borderColor: 'rgba(255, 99, 132, 1)',
                                borderWidth: 1,
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                title: {
                                    display: true,
                                    text: 'Calories (kcal)'
                                }
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                title: {
                                    display: true,
                                    text: 'Macronutrients (g)'
                                },
                                grid: {
                                    drawOnChartArea: false
                                }
                            }
                        }
                    }
                });
            });
        </script>
    }
}