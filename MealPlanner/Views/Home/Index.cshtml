@{
    ViewData["Title"] = "Welcome to Meal Planner";
}

<div class="text-center">
    <h1>Welcome to Meal Planner</h1>
    <p>Plan your meals, manage your recipes, and track your pantry inventory.</p>

    <!-- JWT Auth UI -->
    <div id="jwtAuthUI" class="mt-4">
        <!-- Shown when logged in -->
        <div id="loggedInUI" style="display: none;">
            <h3>Welcome, <span id="welcomeUsername">User</span>!</h3>
            <div class="mt-3">
                <a href="/Identity/Account/Manage" class="btn btn-info">Manage Account</a>
                <button onclick="jwtLogout()" class="btn btn-danger">Logout</button>
            </div>
        </div>
        
        <!-- Shown when logged out -->
        <div id="loggedOutUI">
            <a class="btn btn-primary" href="/JwtLogin">Log in</a>
            <a class="btn btn-success" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Check if the user is logged in
        function updateAuthUI() {
            const token = localStorage.getItem('jwt_token');
            let isLoggedIn = false;
            let username = 'User';
            
            if (token) {
                try {
                    // Parse the JWT token
                    const payload = JSON.parse(atob(token.split('.')[1]));
                    // Check if token is expired
                    isLoggedIn = payload.exp * 1000 > Date.now();
                    // Get the username
                    username = payload.name || payload.unique_name || payload.email || 'User';
                } catch (e) {
                    console.error('Error parsing token:', e);
                }
            }
            
            // Update the UI
            document.getElementById('loggedInUI').style.display = isLoggedIn ? 'block' : 'none';
            document.getElementById('loggedOutUI').style.display = isLoggedIn ? 'none' : 'block';
            document.getElementById('welcomeUsername').textContent = username;
        }
        
        // Logout function
        function jwtLogout() {
            const token = localStorage.getItem('jwt_token');
            
            // Call logout API
            if (token) {
                fetch('/api/Account/logout', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                }).catch(error => console.error('Logout error:', error))
                .finally(() => {
                    // Clear storage and cookies regardless of API response
                    localStorage.removeItem('jwt_token');
                    localStorage.removeItem('refresh_token');
                    document.cookie = 'jwt_auth=; path=/; expires=Thu, 01 Jan 1970 00:00:01 GMT;';
                    // Update UI and redirect
                    updateAuthUI();
                });
            }
        }
        
        // Initialize
        document.addEventListener('DOMContentLoaded', updateAuthUI);
    </script>
}