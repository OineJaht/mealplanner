@{
    ViewData["Title"] = "About";
}

<div class="container">
    <h1 class="mb-4">About Meal Planner</h1>
    
    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="card-title">Our Mission</h2>
                    <p class="card-text">
                        Meal Planner was created to simplify your daily meal planning, nutrition tracking, and grocery shopping. 
                        Our comprehensive solution helps you make informed decisions about your diet, reduce food waste, 
                        save time on shopping, and enjoy a more organized approach to meal preparation.
                    </p>
                </div>
            </div>
            
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="card-title">Key Features</h2>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <strong>Recipe Management</strong>
                            <p>Create, categorize, and maintain detailed recipes with instructions, serving sizes, and preparation times.</p>
                        </li>
                        <li class="list-group-item">
                            <strong>Meal Planning</strong>
                            <p>Schedule meals across a calendar, linking to specific recipes and tracking planned vs. actual consumption.</p>
                        </li>
                        <li class="list-group-item">
                            <strong>Nutrition Tracking</strong>
                            <p>Calculate and display comprehensive nutritional information for both recipes and ingredients.</p>
                        </li>
                        <li class="list-group-item">
                            <strong>Pantry Inventory</strong>
                            <p>Track ingredients you have on hand, including amounts, storage locations, and expiry dates.</p>
                        </li>
                        <li class="list-group-item">
                            <strong>Shopping List Generation</strong>
                            <p>Create shopping lists based on planned meals and current pantry inventory.</p>
                        </li>
                        <li class="list-group-item">
                            <strong>"What Can I Cook?" Feature</strong>
                            <p>Get suggestions for recipes based on available ingredients.</p>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">Technology Stack</h3>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">ASP.NET Core MVC</li>
                        <li class="list-group-item">Entity Framework Core</li>
                        <li class="list-group-item">PostgreSQL</li>
                        <li class="list-group-item">Bootstrap</li>
                        <li class="list-group-item">C#</li>
                        <li class="list-group-item">HTML, CSS, and JavaScript</li>
                    </ul>
                </div>
            </div>
            
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title">App Version</h3>
                    <p class="card-text">Version 1.0.0</p>
                    <p class="card-text"><small class="text-muted">Released April 2025</small></p>
                </div>
            </div>
        </div>
    </div>
</div>