@model MealPlanner.Models.ViewModels.UserPantry.UserPantryLowStockViewModel
@{
ViewData["Title"] = PantryLocalizer["LowStockItems"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@PantryLocalizer["LowStockItems"]</h1>
    <div>
        <a asp-action="Create" class="btn btn-success me-2">
            <i class="bi bi-plus-circle"></i> @PantryLocalizer["AddNewItem"]
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> @PantryLocalizer["BackToPantry"]
        </a>
    </div>
</div>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle"></i>
    @PantryLocalizer["LowStockItemsWarning"]
</div>

@if (Model != null && Model.Items.Any())
{
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4>@PantryLocalizer["ItemsToRestock"]</h4>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                        <tr>
                            <th>@PantryLocalizer["Ingredient"]</th>
                            <th>@PantryLocalizer["AmountLeft"]</th>
                            <th>@PantryLocalizer["Location"]</th>
                            <th>@PantryLocalizer["ExpiryDate"]</th>
                            <th>@Localizer["Actions"]</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Items.OrderBy(i => i.AmountInStock))
                        {
                        <tr>
                            <td>
                                <strong>@item.IngredientName</strong>
                                @if (!string.IsNullOrEmpty(item.IngredientCategory))
                                {
                                <small class="text-muted d-block">@item.IngredientCategory</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-warning text-dark">@item.AmountInStock @item.Unit</span>
                            </td>
                            <td>@item.Location</td>
                            <td>
                                @item.ExpiryDate.ToShortDateString()
                                @{
                                var daysUntilExpiry = (item.ExpiryDate - DateTime.Today).Days;
                                if (daysUntilExpiry < 0)
                                {
                                <span class="badge bg-danger ms-1">@PantryLocalizer["Expired"]</span>
                                }
                                else if (daysUntilExpiry <= 7)
                                {
                                <span class="badge bg-warning text-dark ms-1">@PantryLocalizer["Soon"]</span>
                                }
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-success add-to-list-btn" data-id="@item.Id" data-name="@item.IngredientName">
                                        <i class="bi bi-cart-plus"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header">
                <h4>@PantryLocalizer["QuickActions"]</h4>
            </div>
            <div class="card-body">
                <form asp-action="AddMultipleToShoppingList" method="post" id="bulkAddForm">
                    <div class="mb-3">
                        <label for="shoppingListId" class="form-label">@PantryLocalizer["SelectShoppingList"]</label>
                        <select name="shoppingListId" id="shoppingListId" class="form-select" required>
                            <option value="">-- @PantryLocalizer["SelectShoppingList"] --</option>
                            @foreach (var shoppingList in Model.AvailableShoppingLists)
                            {
                            <option value="@shoppingList.Value">@shoppingList.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="selectAll">
                            <label class="form-check-label" for="selectAll">
                                <strong>@PantryLocalizer["SelectAll"]</strong>
                            </label>
                        </div>

                        <div class="mt-2" style="max-height: 200px; overflow-y: auto;">
                            @foreach (var item in Model.Items)
                            {
                            <div class="form-check">
                                <input class="form-check-input item-checkbox" type="checkbox"
                                       name="selectedItems" value="@item.Id" id="item_@item.Id">
                                <label class="form-check-label" for="item_@item.Id">
                                    @item.IngredientName (@item.AmountInStock @item.Unit @Localizer["left"])
                                </label>
                            </div>
                            }
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-cart-plus"></i> @PantryLocalizer["AddSelectedToShoppingList"]
                        </button>

                        <a href="#" class="btn btn-outline-success create-shopping-list-link">
                            <i class="bi bi-list-check"></i> @PantryLocalizer["CreateNewShoppingListFromSelected"]
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h4>@PantryLocalizer["PantryManagementTips"]</h4>
            </div>
            <div class="card-body">
                <ul>
                    <li><strong>@PantryLocalizer["RegularInventoryTip"]</strong></li>
                    <li><strong>@PantryLocalizer["FirstInFirstOutTip"]</strong></li>
                    <li><strong>@PantryLocalizer["StorageOrganizationTip"]</strong></li>
                    <li><strong>@PantryLocalizer["MinMaxLevelsTip"]</strong></li>
                </ul>
            </div>
        </div>
    </div>
</div>
}
else
{
<div class="alert alert-success">
    <h4 class="alert-heading">@PantryLocalizer["AllStockedUp"]</h4>
    <p>@PantryLocalizer["NoLowStockItems"]</p>
    <hr>
    <p class="mb-0">
        <a asp-action="Index" class="btn btn-outline-primary">
            @PantryLocalizer["ViewAllPantryItems"]
        </a>
    </p>
</div>
}

<!-- Add to Shopping List Modal -->
<div class="modal fade" id="addToShoppingListModal" tabindex="-1" aria-labelledby="addToShoppingListModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addToShoppingListModalLabel">@PantryLocalizer["AddToShoppingList"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddToShoppingList" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" id="pantryItemId" value="" />

                    <div class="mb-3">
                        <label for="modalShoppingListId" class="form-label">@PantryLocalizer["SelectShoppingList"]</label>
                        <select name="shoppingListId" id="modalShoppingListId" class="form-select" required>
                            <option value="">-- @PantryLocalizer["SelectShoppingList"] --</option>
                            @if (Model != null)
                            {
                                @foreach (var shoppingList in Model.AvailableShoppingLists)
                                {
                                    <option value="@shoppingList.Value">@shoppingList.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="alert alert-info">
                        <p>@Localizer["This will add"] <span id="ingredientName"></span> @Localizer["to your selected shopping list."]</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@PantryLocalizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@PantryLocalizer["AddToList"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        // Handle "Select All" checkbox
        $("#selectAll").change(function() {
            $(".item-checkbox").prop('checked', $(this).prop('checked'));
        });

        // Update "Select All" checkbox when individual items change
        $(".item-checkbox").change(function() {
            if ($(".item-checkbox:checked").length === $(".item-checkbox").length) {
                $("#selectAll").prop('checked', true);
            } else {
                $("#selectAll").prop('checked', false);
            }
        });

        // Handle Add to Shopping List button
        $(".add-to-list-btn").click(function() {
            const itemId = $(this).data('id');
            const itemName = $(this).data('name');

            $("#pantryItemId").val(itemId);
            $("#ingredientName").text(itemName);
            $("#addToShoppingListModal").modal('show');
        });

        // Handle Create Shopping List link
        $(".create-shopping-list-link").click(function(e) {
            e.preventDefault();

            const selectedItems = $(".item-checkbox:checked");
            if (selectedItems.length === 0) {
                alert("@Localizer["Please select at least one item."]");
                return;
            }

            // Change form action and submit
            $("#bulkAddForm").attr('action', '@Url.Action("CreateShoppingListFromPantry")');
            $("#bulkAddForm").submit();
        });
    });
</script>
}