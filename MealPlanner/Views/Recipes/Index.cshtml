@model IEnumerable<MealPlanner.Dto.RecipeDto>
@{
ViewData["Title"] = RecipeLocalizer["RecipesList"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@RecipeLocalizer["RecipesList"]</h1>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> @RecipeLocalizer["CreateRecipe"]
        </a>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" id="searchInput" class="form-control" placeholder="@RecipeLocalizer["SearchRecipes"]">
            <button class="btn btn-outline-secondary" type="button" id="searchButton">
                <i class="bi bi-search"></i> @Localizer["Search"]
            </button>
        </div>
    </div>
    <div class="col-md-3">
        <select id="categoryFilter" class="form-select">
            <option value="">@RecipeLocalizer["AllCategories"]</option>
            @{
            // Extract unique categories from all recipes
            var categories = new HashSet<string>();
            foreach (var recipe in Model)
            {
            if (recipe.Categories != null)
            {
            foreach (var category in recipe.Categories)
            {
            if (!string.IsNullOrEmpty(category.Name))
            {
            categories.Add(category.Name);
            }
            }
            }
            }

            foreach (var category in categories.OrderBy(c => c))
            {
            <option value="@category">@category</option>
            }
            }
        </select>
    </div>
    <div class="col-md-3">
        <div class="form-check form-switch mt-2">
            <input class="form-check-input" type="checkbox" id="favoritesOnly">
            <label class="form-check-label" for="favoritesOnly">@RecipeLocalizer["FavoritesOnly"]</label>
        </div>
    </div>
</div>

@if (Model != null && Model.Any())
{
<div class="row" id="recipeCards">
    @foreach (var recipe in Model)
    {
    <div class="col-md-4 mb-4 recipe-card"
         data-name="@recipe.Name?.ToLower()"
         data-favorite="@recipe.IsFavorite.ToString().ToLower()"
         data-categories="@(recipe.Categories != null ? string.Join(" ", recipe.Categories.Select(c => c.Name?.ToLower() ?? "")) : "")">
        <div class="card h-100 @(recipe.IsFavorite ? "border-warning" : "")">
            @if (!string.IsNullOrEmpty(recipe.ImageUrl))
            {
            <img src="@recipe.ImageUrl" class="card-img-top" alt="@recipe.Name" style="height: 200px; object-fit: cover;">
            }
            else
            {
            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                <i class="bi bi-card-image text-muted" style="font-size: 48px;"></i>
            </div>
            }
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <h5 class="card-title">@recipe.Name</h5>
                    @if (recipe.IsFavorite)
                    {
                    <i class="bi bi-star-fill text-warning" style="font-size: 1.2rem;"></i>
                    }
                </div>
                @if (!string.IsNullOrEmpty(recipe.Description) && recipe.Description.Length > 100)
                {
                <p class="card-text">@recipe.Description.Substring(0, 100)...</p>
                }
                else
                {
                <p class="card-text">@recipe.Description</p>
                }
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <small class="text-muted">
                        <i class="bi bi-clock"></i> @recipe.PrepTimeMinutes min
                        <span class="ms-2"><i class="bi bi-people"></i> @recipe.DefaultServings @RecipeLocalizer["Servings"]</span>
                    </small>
                </div>
                @if (recipe.Categories != null && recipe.Categories.Any())
                {
                <div class="mt-2">
                    @foreach (var category in recipe.Categories.Take(3))
                    {
                    <span class="badge bg-secondary me-1">@category.Name</span>
                    }
                    @if (recipe.Categories.Count > 3)
                    {
                    <span class="badge bg-light text-dark">+@(recipe.Categories.Count - 3)</span>
                    }
                </div>
                }
            </div>
            <div class="card-footer bg-transparent">
                <div class="btn-group btn-group-sm w-100">
                    <a asp-action="Details" asp-route-id="@recipe.Id" class="btn btn-outline-primary">
                        <i class="bi bi-eye"></i> @Localizer["Details"]
                    </a>
                    <a asp-action="Edit" asp-route-id="@recipe.Id" class="btn btn-outline-secondary">
                        <i class="bi bi-pencil"></i> @Localizer["Edit"]
                    </a>
                    <a asp-action="Delete" asp-route-id="@recipe.Id" class="btn btn-outline-danger">
                        <i class="bi bi-trash"></i> @Localizer["Delete"]
                    </a>
                </div>
            </div>
        </div>
    </div>
    }
</div>
}
else
{
<div class="alert alert-info">
    <p>@RecipeLocalizer["NoRecipesAvailable"]</p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> @RecipeLocalizer["CreateFirstRecipe"]
    </a>
</div>
}



@section Scripts {
<script>
    $(document).ready(function() {
        // Search and filtering functionality
        function filterRecipes() {
            var searchText = $("#searchInput").val().toLowerCase();
            var category = $("#categoryFilter").val().toLowerCase();
            var favoritesOnly = $("#favoritesOnly").is(":checked");

            $(".recipe-card").each(function() {
                var name = $(this).data("name");
                var favorite = $(this).data("favorite");
                var categories = $(this).data("categories");

                var nameMatch = name.indexOf(searchText) > -1;
                var categoryMatch = category === "" || categories.indexOf(category) > -1;
                var favoriteMatch = !favoritesOnly || favorite === "true";

                $(this).toggle(nameMatch && categoryMatch && favoriteMatch);
            });

            // Show message if no recipes match filters
            if ($(".recipe-card:visible").length === 0) {
                if ($("#noMatchesMessage").length === 0) {
                    $("#recipeCards").after(
                        '<div id="noMatchesMessage" class="alert alert-info mt-3">' +
                        'No recipes match your current filters. Try adjusting your search criteria.' +
                        '</div>'
                    );
                }
            } else {
                $("#noMatchesMessage").remove();
            }
        }

        $("#searchInput, #categoryFilter").on("keyup change", filterRecipes);
        $("#searchButton").on("click", filterRecipes);
        $("#favoritesOnly").on("change", filterRecipes);
    });
</script>
}