@model MealPlanner.Models.ViewModels.Categories.CategoryDeleteViewModel
@{
    ViewData["Title"] = CategoriesLocalizer["DeleteCategory"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@CategoriesLocalizer["DeleteCategory"]</h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> @Localizer["BackToList"]
        </a>
    </div>
</div>

<div class="alert alert-danger">
    <h3>
        <i class="bi bi-exclamation-triangle"></i> @CategoriesLocalizer["DeleteCategoryConfirmation"]
    </h3>
    <p>@CategoriesLocalizer["DeleteCategoryWarning"]</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h4>@CategoriesLocalizer["CategoryToDelete"]</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">@CategoriesLocalizer["Name"]</dt>
                    <dd class="col-sm-8">@Model.Category.Name</dd>

                    <dt class="col-sm-4">@CategoriesLocalizer["Description"]</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Category.Description) ? "-" : Model.Category.Description)</dd>
                </dl>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        @if (ViewBag.RecipeCount != null && (int)ViewBag.RecipeCount > 0)
        {
            <div class="card bg-warning text-dark mb-4">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-exclamation-triangle"></i> @Localizer["Warning"]
                    </h5>
                    <p class="card-text">
                        @String.Format(CategoriesLocalizer["CategoryUsedByRecipes"].Value, ViewBag.RecipeCount)
                    </p>
                    <p class="card-text">
                        @CategoriesLocalizer["DeleteCategoryRecipeWarning"]
                    </p>
                </div>
            </div>
        }
    </div>
</div>

<form asp-action="Delete" id="deleteCategoryForm">
    <input type="hidden" asp-for="Category.Id" />
    <div class="mt-3">
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> @Localizer["ConfirmDelete"]
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-circle"></i> @Localizer["Cancel"]
        </a>
    </div>
</form>

@section Scripts {
    <script>
        // Optional: AJAX delete functionality
        $(function() {
            $("#deleteCategoryForm").on("submit", function(e) {
                if (!confirm("@CategoriesLocalizer["FinalDeleteConfirmation"]")) {
                    e.preventDefault();
                    return false;
                }
                
                @if (ViewBag.RecipeCount != null && (int)ViewBag.RecipeCount > 0)
                {
                    <text>
                    if (!confirm("@String.Format(CategoriesLocalizer["DeleteWithRecipesConfirmation"].Value, ViewBag.RecipeCount)")) {
                        e.preventDefault();
                        return false;
                    }
                    </text>
                }
                
                return true;
            });
        });
    </script>
}