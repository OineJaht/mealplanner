@model MealPlanner.Models.ViewModels.Categories.CategoryIndexViewModel
@{
    ViewData["Title"] = CategoriesLocalizer["Categories"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@CategoriesLocalizer["Categories"]</h1>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> @CategoriesLocalizer["CreateCategory"]
        </a>
    </div>
</div>

@if (Model != null && Model.Categories.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>@CategoriesLocalizer["Name"]</th>
                    <th>@CategoriesLocalizer["Description"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Categories)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> @Localizer["Edit"]
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye"></i> @Localizer["Details"]
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> @Localizer["Delete"]
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> @CategoriesLocalizer["NoCategoriesFound"]
    </div>
}

@section Scripts {
    <script>
        // AJAX category creation
        $(function() {
            $("#createCategoryModal form").on("submit", function(e) {
                e.preventDefault();
                
                var formData = {
                    name: $("#CategoryName").val(),
                    description: $("#CategoryDescription").val()
                };
                
                $.ajax({
                    url: '@Url.Action("CreateAjax")',
                    type: 'POST',
                    data: formData,
                    success: function(result) {
                        if (result.success) {
                            // Refresh the page to show the new category
                            location.reload();
                        } else {
                            // Show error message
                            $("#createCategoryError").text(result.message).show();
                        }
                    },
                    error: function(xhr, status, error) {
                        $("#createCategoryError").text("An error occurred: " + error).show();
                    }
                });
            });
        });
    </script>
}