@model MealPlanner.Models.ViewModels.Categories.CategoryEditViewModel
@{
    ViewData["Title"] = CategoriesLocalizer["EditCategory"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@CategoriesLocalizer["EditCategory"]</h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> @Localizer["BackToList"]
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Category.Id" />
                    
                    <div class="mb-3">
                        <label asp-for="Category.Name" class="form-label">@CategoriesLocalizer["Name"]</label>
                        <input asp-for="Category.Name" class="form-control" />
                        <span asp-validation-for="Category.Name" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Category.Description" class="form-label">@CategoriesLocalizer["Description"]</label>
                        <textarea asp-for="Category.Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Category.Description" class="text-danger"></span>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> @Localizer["Save"]
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Category.Id" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> @Localizer["Cancel"]
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card bg-light">
            <div class="card-body">
                <h5 class="card-title">@CategoriesLocalizer["EditHelpTitle"]</h5>
                <p class="card-text">
                    @CategoriesLocalizer["EditCategoryHelpText"]
                </p>
                
                @if (ViewBag.RecipeCount != null && (int)ViewBag.RecipeCount > 0)
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i> 
                        @String.Format(CategoriesLocalizer["CategoryUsedByRecipes"].Value, ViewBag.RecipeCount)
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // AJAX update handler
        $(function() {
            $("#editCategoryForm").on("submit", function(e) {
                e.preventDefault();
                
                var formData = {
                    id: $("#Id").val(),
                    name: $("#Name").val(),
                    description: $("#Description").val()
                };
                
                $.ajax({
                    url: '@Url.Action("EditAjax")',
                    type: 'POST',
                    data: formData,
                    success: function(result) {
                        if (result.success) {
                            window.location.href = '@Url.Action("Index")';
                        } else {
                            $("#editCategoryError").text(result.message).show();
                        }
                    },
                    error: function(xhr, status, error) {
                        $("#editCategoryError").text("An error occurred: " + error).show();
                    }
                });
            });
        });
    </script>
}