@model MealPlanner.Models.ViewModels.Categories.CategoryDetailsViewModel
@{
    ViewData["Title"] = CategoriesLocalizer["CategoryDetails"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@CategoriesLocalizer["CategoryDetails"]</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Category.Id" class="btn btn-outline-primary me-2">
            <i class="bi bi-pencil"></i> @Localizer["Edit"]
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> @Localizer["BackToList"]
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h4>@CategoriesLocalizer["BasicInformation"]</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">@CategoriesLocalizer["Name"]</dt>
                    <dd class="col-sm-8">@Model.Category.Name</dd>

                    <dt class="col-sm-4">@CategoriesLocalizer["Description"]</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Category.Description) ? "-" : Model.Category.Description)</dd>
                </dl>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        @if (ViewBag.RecipeCount != null)
        {
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">@CategoriesLocalizer["Statistics"]</h5>
                    <p class="card-text">
                        @String.Format(CategoriesLocalizer["CategoryUsedInRecipes"].Value, ViewBag.RecipeCount)
                    </p>
                </div>
            </div>
        }
    </div>
</div>

@if (ViewBag.Recipes != null && ((IEnumerable<dynamic>)ViewBag.Recipes).Any())
{
    <div class="card mt-4">
        <div class="card-header">
            <h4>@CategoriesLocalizer["RecipesInCategory"]</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>@RecipeLocalizer["Name"]</th>
                            <th>@RecipeLocalizer["PrepTime"]</th>
                            <th>@RecipeLocalizer["DefaultServings"]</th>
                            <th>@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var recipe in (IEnumerable<dynamic>)ViewBag.Recipes)
                        {
                            <tr>
                                <td>@recipe.Name</td>
                                <td>@recipe.PrepTimeMinutes @RecipeLocalizer["Minutes"]</td>
                                <td>@recipe.DefaultServings</td>
                                <td>
                                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i> @Localizer["View"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info mt-4">
        <i class="bi bi-info-circle"></i> @CategoriesLocalizer["NoRecipesInCategory"]
    </div>
}