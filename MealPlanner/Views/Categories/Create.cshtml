@model MealPlanner.Models.ViewModels.Categories.CategoryCreateViewModel
@{
    ViewData["Title"] = CategoriesLocalizer["CreateCategory"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@CategoriesLocalizer["CreateCategory"]</h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> @Localizer["BackToList"]
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Category.Name" class="form-label">@CategoriesLocalizer["Name"]</label>
                        <input asp-for="Category.Name" class="form-control" />
                        <span asp-validation-for="Category.Name" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Category.Description" class="form-label">@CategoriesLocalizer["Description"]</label>
                        <textarea asp-for="Category.Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Category.Description" class="text-danger"></span>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> @Localizer["Create"]
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> @Localizer["Cancel"]
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card bg-light">
            <div class="card-body">
                <h5 class="card-title">@CategoriesLocalizer["HelpTitle"]</h5>
                <p class="card-text">
                    @CategoriesLocalizer["CategoryHelpText"]
                </p>
                <ul>
                    <li>@CategoriesLocalizer["CategoryHelpPoint1"]</li>
                    <li>@CategoriesLocalizer["CategoryHelpPoint2"]</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}