    <!-- Food Storage Tips -->
    <data name="VegetableTip1" xml:space="preserve">
    <value>Most vegetables stay fresh longer in the refrigerator's crisper drawer.</value>
  </data>
    <data name="VegetableTip2" xml:space="preserve">
    <value>Store leafy greens in a container with a paper towel to absorb excess moisture.</value>
  </data>
    <data name="FruitTip1" xml:space="preserve">
    <value>Some fruits like bananas, avocados, and tomatoes continue to ripen at room temperature.</value>
  </data>
    <data name="FruitTip2" xml:space="preserve">
    <value>Refrigerate ripe fruits to extend their life.</value>
  </data>
    <data name="MeatTip1" xml:space="preserve">
    <value>Store raw meat on the bottom shelf of the refrigerator to prevent drips onto other foods.</value>
  </data>
    <data name="MeatTip2" xml:space="preserve">
    <value>Use or freeze meat within 2-3 days of purchase for best quality.</value>
  </data>
    <data name="DairyTip1" xml:space="preserve">
    <value>Store dairy products in the coldest part of the refrigerator, not in the door.</value>
  </data>
    <data name="DairyTip2" xml:space="preserve">
    <value>Keep dairy tightly sealed to prevent absorbing odors from other foods.</value>
  </data>
    <data name="GrainTip1" xml:space="preserve">
    <value>Store grains in airtight containers to protect from moisture and pests.</value>
  </data>
    <data name="GrainTip2" xml:space="preserve">
    <value>Whole grains can be refrigerated or frozen to extend shelf life.</value>
  </data>
    <data name="HerbTip1" xml:space="preserve">
    <value>Store herbs and spices in a cool, dark place to preserve flavor and color.</value>
  </data>
    <data name="HerbTip2" xml:space="preserve">
    <value>Fresh herbs can be stored in water like a bouquet or wrapped in a damp paper towel.</value>
  </data>
    <data name="GeneralTip1" xml:space="preserve">
    <value>Check food regularly for signs of spoilage like unusual smell, color, or texture.</value>
  </data>
    <data name="GeneralTip2" xml:space="preserve">
    <value>Rotate your pantry items to use oldest items first.</value>
  </data>
    <data name="FoodSafetyTips" xml:space="preserve">
