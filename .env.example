# Copy this file to .env and fill in your own values. Never commit .env.
POSTGRES_DB=mealplanner
POSTGRES_USER=mealplanner
DB_PASSWORD=change-me
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=MealPlannerApi
JWT_AUDIENCE=MealPlannerClient
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Password for the seeded admin user (admin@mealplanner.com). If empty, no admin is created.
ADMIN_PASSWORD=change-me
